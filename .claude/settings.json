{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/workflow_status.py\" --session",
            "timeout": 30,
            "statusMessage": "workflow v2: reading the checklist"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session_state.py\" --markdown --write --detach",
            "timeout": 30,
            "statusMessage": "session state: writing the facts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/push_gate.py\"",
            "timeout": 30,
            "statusMessage": "push gate: checking CI"
          }
        ]
      }
    ]
  }
}
